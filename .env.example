NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
NEXT_PUBLIC_SITE_URL=https://your-app.example.com
# Test environments only. Never use a production service-role key for E2E tests.
SUPABASE_SERVICE_ROLE_KEY=your-test-service-role-key
# Required only for the destructive demo seed command.
APP_ENVIRONMENT=local
ALLOW_DEMO_SEED=false
DEMO_SEED_PROJECT_REF=local
