NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
NEXT_PUBLIC_SITE_URL=https://your-app.example.com
# Server-side deployment metadata. RELEASE_VERSION should be an immutable commit SHA or tag.
APP_ENVIRONMENT=local
RELEASE_VERSION=development
# Optional approved Sentry-compatible error tracking. The browser DSN is public;
# keep the source-map upload token only in trusted CI, never in app runtime.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_APP_ENVIRONMENT=local
NEXT_PUBLIC_RELEASE_VERSION=development
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
# Registration is blocked in production until every legal value is set, the
# approved version is activated in legal_document_versions, and approval=true.
LEGAL_DOCUMENT_APPROVED=false
LEGAL_DOCUMENT_VERSION=replace-with-approved-version
LEGAL_DOCUMENT_EFFECTIVE_DATE=2026-08-09
LEGAL_OPERATOR_NAME=replace-with-operator-name
LEGAL_OPERATOR_ADDRESS=replace-with-operator-address
LEGAL_OPERATOR_EMAIL=privacy@example.com
# Semicolon-separated processors/infrastructure providers named in the documents.
LEGAL_PROCESSORS=replace-with-hosting-provider; replace-with-email-provider
# Production Compose only: public DNS names and the private Supabase gateway upstream.
APP_DOMAIN=app.example.com
SUPABASE_DOMAIN=api.example.com
SUPABASE_UPSTREAM=host.docker.internal:8000
# Trusted operator preflight/invitation CLI or test fixtures only. Never configure a
# service-role key in the app runtime. Load it from a secret manager when needed.
SUPABASE_SERVICE_ROLE_KEY=your-operator-or-test-service-role-key
# Trusted operator CLI only. The exact target URL prevents accidental writes to another project.
ALLOW_BETA_INVITE_CREATE=false
BETA_INVITE_TARGET_URL=https://your-project.supabase.co
# Required only for the destructive demo seed command.
ALLOW_DEMO_SEED=false
DEMO_SEED_PROJECT_REF=local
# One-click login is accepted only when APP_ENVIRONMENT=demo. These credentials
# must belong to the isolated synthetic demo project, never production.
DEMO_ACCESS_ENABLED=false
DEMO_FOUNDER_EMAIL=demo-founder@startup-zone.example
DEMO_FOUNDER_PASSWORD=replace-with-long-demo-password
DEMO_INVESTOR_EMAIL=demo-investor@startup-zone.example
DEMO_INVESTOR_PASSWORD=replace-with-long-demo-password
